{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evaluationcontextprotocol.io/schema/manifest.schema.json",
  "title": "ECP Manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "type": "string",
      "const": "v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string"
                },
                "constraints": {
                  "type": "object",
                  "additionalProperties": true
                },
                "graders": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "text_match",
                          "llm_judge",
                          "tool_usage"
                        ]
                      },
                      "field": {
                        "type": "string",
                        "enum": [
                          "public_output",
                          "evaluation_context",
                          "private_thought"
                        ]
                      },
                      "condition": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "enum": [
                          "contains",
                          "equals",
                          "does_not_contain",
                          "regex",
                          "called",
                          "not_called",
                          null
                        ],
                        "description": "text_match: contains, equals, does_not_contain, regex. tool_usage: called (the default) or not_called."
                      },
                      "value": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "pattern": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "minLength": 1
                      },
                      "prompt": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "assertion": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "tool_name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "arguments": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "text_match"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "condition"
                          ],
                          "properties": {
                            "condition": {
                              "type": "string"
                            }
                          },
                          "allOf": [
                            {
                              "if": {
                                "properties": {
                                  "condition": {
                                    "const": "regex"
                                  }
                                }
                              },
                              "then": {
                                "required": [
                                  "pattern"
                                ],
                                "properties": {
                                  "pattern": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                }
                              },
                              "else": {
                                "required": [
                                  "value"
                                ],
                                "properties": {
                                  "value": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          ]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "llm_judge"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "prompt"
                          ],
                          "properties": {
                            "prompt": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "\\S"
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "tool_usage"
                            },
                            "condition": {
                              "const": "not_called"
                            }
                          },
                          "required": [
                            "type",
                            "condition"
                          ]
                        },
                        "then": {
                          "required": [
                            "tool_name"
                          ],
                          "properties": {
                            "tool_name": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "required": [
                "input"
              ]
            }
          },
          "dataset": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "csv",
                  "jsonl"
                ]
              },
              "source": {
                "type": "string"
              },
              "input_column": {
                "type": "string",
                "default": "input"
              },
              "output_column": {
                "type": "string",
                "default": "output"
              }
            },
            "required": [
              "type",
              "source"
            ]
          }
        },
        "required": [
          "name"
        ],
        "anyOf": [
          {
            "required": [
              "steps"
            ]
          },
          {
            "required": [
              "dataset"
            ]
          }
        ]
      }
    },
    "require_capabilities": {
      "type": "boolean",
      "default": false,
      "description": "Abort before execution when the agent does not declare a capability this manifest needs. Off by default, because an empty capability set means undeclared rather than unsupported."
    }
  },
  "required": [
    "manifest_version",
    "name",
    "target",
    "scenarios"
  ]
}
